#!/usr/bin/env bash
# universal-modder's `um`, run from universal-optimizer's environment (it is a dependency), so skills can say `um ...`.
# Uses uv when available (it creates the project's .venv with psutil + universal-modder on first run);
# otherwise the system python3, which then needs `pip install psutil git+https://github.com/rehan-remade/universal-modder`.
set -euo pipefail
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"
if command -v uv >/dev/null 2>&1 && [ -z "${UO_NO_UV:-}" ]; then
  exec uv run --quiet --project "$ROOT" python -m um "$@"
fi
PY="$(command -v python3 || command -v python)"
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m uo "$@"
